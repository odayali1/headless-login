PORT=3847
DATA_DIR=/app/data
CREDENTIALS_KEY=change-me-to-a-long-random-secret
API_KEY=change-me-to-a-long-random-api-key-min-16-chars
CAMOUFOX_INSTALL_DIR=/app/data/camoufox
MOZ_DISABLE_CONTENT_SANDBOX=1
MOZ_DISABLE_GMP_SANDBOX=1
# SOCKS5 default for iProxy + Camoufox. HTTP :16857 optional fallback only.
PROXY_URL=socks5://host:17539:user:pass
# PROXY_HTTP_URL=http://host:16857:user:pass
# PROXY_PREFER=socks
PROXY_ROTATE_URL=https://your-provider/changeip/token
PROXY_ROTATE_WAIT_MS=30000

# Smart refresh — HTTP/Loki fast lane + Camoufox slow lane (refills immediately)
# SMART_REFRESH_INTERVAL_MS=60000
# SMART_REFRESH_BROWSERLESS_PARALLEL=5
# SMART_REFRESH_CAMOUFOX_PARALLEL=3
# ACCOUNTS_CACHE_TTL_MS=8000
# SMART_REFRESH_AUTO_PAUSE_QUEUE_AT=50
# SMART_REFRESH_FAIL_BACKOFF_MS=900000
# SMART_REFRESH_BUFFER_MS=1200000
# SMART_REFRESH_PRIORITY_WINDOW_MS=1800000
# Optional explicit iProxy HTTP (else derived as SOCKS port-682):
# PROXY_HTTP_URL=http://host:16857:user:pass

# Optional — push account.token_updated to your app (see SYNC-API.md)
# SYNC_WEBHOOK_URL=https://your-app.com/hooks/headless-login
# SYNC_WEBHOOK_SECRET=optional-hmac-secret
