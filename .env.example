PORT=3847
DATA_DIR=/app/data
CREDENTIALS_KEY=change-me-to-a-long-random-secret
API_KEY=change-me-to-a-long-random-api-key-min-16-chars
CAMOUFOX_INSTALL_DIR=/app/data/camoufox
MOZ_DISABLE_CONTENT_SANDBOX=1
MOZ_DISABLE_GMP_SANDBOX=1
# SOCKS5 default for iProxy + Camoufox. HTTP :16857 optional fallback only.
PROXY_URL=socks5://host:17539:user:pass
# PROXY_HTTP_URL=http://host:16857:user:pass
# PROXY_PREFER=socks
PROXY_ROTATE_URL=https://your-provider/changeip/token
# PROXY_ROTATE_WAIT_MS=10000
# iProxy changeip is usually ready in <10s. Code default is 10s (was wrongly forced to 30s).
# PROXY_ROTATE_WAIT_MIN_MS=8000
# Min seconds between IP rotations (stops email-retry thrash killing smart-refresh)
# PROXY_ROTATE_COOLDOWN_MS=120000
# Wait for Camoufox pool to drain before rotating (ms)
# PROXY_ROTATE_DRAIN_MS=15000
# Max wait for live Camoufox relay pins before IP rotate (LOGIN_PARALLEL=2 needs this >> 15s)
# PROXY_ROTATE_PIN_WAIT_MS=200000
# How long to block starting a new login while waiting for a successful rotate
# PROXY_ROTATE_BLOCK_WAIT_MS=240000
# Browserless refresh (Loki/MSAL/cookie SSO) — rotate IP only after this many SUCCESSES, when idle.
# Default 100. Set 0 = never rotate for HTTP. Never mid cookie-SSO. (0 used to bug → rotate every tick.)
# PROXY_HTTP_ROTATE_EVERY=100
# Optional clean IP before login after N HTTP ops (0 = off — keep same IP for PROXY_ROTATE_EVERY logins)
# PROXY_LOGIN_CLEAN_IP_AFTER_HTTP=0
# Gap between batch logins (ms base) — GetCredentialType rate-limits rapid lookups
# LOGIN_BATCH_DELAY_MS=12000
# Parallel Camoufox logins — default 1 (safe). LOGIN_PARALLEL=2 needs LOGIN_PARALLEL_FORCE=1 on mobile proxy.
# LOGIN_PARALLEL=2
# LOGIN_PARALLEL_FORCE=1
# LOGIN_PARALLEL_STAGGER_MS=45000
# Max forced IP rotates per login job when Microsoft returns 429
# LOGIN_MAX_THROTTLE_ROTATES=2
# Don't dedupe non-force rotates if another job rotated within this window (ms)
# PROXY_SHARED_ROTATE_MIN_GAP_MS=25000
# Rotate mobile IP only AFTER this many successful Camoufox logins (never mid-login / email retry)
# PROXY_ROTATE_EVERY=6
# Settle after a batch rotate (ms) — only when rotating between login batches
# PROXY_POST_ROTATE_SETTLE_MS=8000
# Keep Camoufox geoip matched to proxy exit (timezone/locale)
# CAMOUFOX_GEOIP=1

# Smart refresh — HTTP/Loki fast lane + Camoufox slow lane (refills immediately)
# SMART_REFRESH_INTERVAL_MS=60000
# SMART_REFRESH_BROWSERLESS_PARALLEL=2
# Prefer 2 on iProxy mobile — 5 parallel floods login.live.com and dies with TLS hangups.
# During login + LOGIN_HTTP_COOLDOWN_MS after: no HTTP (prevents GetCredentialType 429).
# LOGIN_HTTP_COOLDOWN_MS=180000
# After gct=429: rotate once, settle this long, one retry with new Camoufox device.
# GCT_429_SETTLE_MS=45000
# SMART_REFRESH_CAMOUFOX_PARALLEL=3
# (↑ only smart-refresh Camoufox — login parallelism is LOGIN_PARALLEL above)
# ACCOUNTS_CACHE_TTL_MS=8000
# SMART_REFRESH_AUTO_PAUSE_QUEUE_AT=50
# SMART_REFRESH_FAIL_BACKOFF_MS=900000
# SMART_REFRESH_BUFFER_MS=1200000
# SMART_REFRESH_PRIORITY_WINDOW_MS=1800000
# Optional explicit iProxy HTTP (else derived as SOCKS port-682):
# PROXY_HTTP_URL=http://host:16857:user:pass

# Optional — push account.token_updated to your app (see SYNC-API.md)
# SYNC_WEBHOOK_URL=https://your-app.com/hooks/headless-login
# SYNC_WEBHOOK_SECRET=optional-hmac-secret
