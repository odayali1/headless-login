PORT=3847
DATA_DIR=/app/data
CREDENTIALS_KEY=change-me-to-a-long-random-secret
API_KEY=change-me-to-a-long-random-api-key-min-16-chars
CAMOUFOX_INSTALL_DIR=/app/data/camoufox
MOZ_DISABLE_CONTENT_SANDBOX=1
MOZ_DISABLE_GMP_SANDBOX=1
# Proxy profile: mobile (iProxy) OR residential (rotating SOCKS).
# PROXY_PROFILE is only the INITIAL default. Dashboard switch is stored in DB and wins at runtime.
# Do NOT leave PROXY_PROFILE=residential if the SOCKS is broken — refresh will use it and fail.
# To force env on every boot: PROXY_PROFILE_LOCK=1
# PROXY_PROFILE=mobile
# PROXY_PROFILE_LOCK=0
# Mobile iProxy (also accepted as PROXY_URL for backward compat):
PROXY_URL=socks5://host:17539:user:pass
# PROXY_MOBILE_URL=socks5://host:17539:user:pass
# Residential rotating SOCKS (built-in default exists for Hybrid mode; override if needed):
# PROXY_RESIDENTIAL_URL=socks5://user:pass@host:port
# Hybrid (dashboard toggle): Loki/MSAL HTTP via residential IPv6; login/Camoufox/cookie via mobile.
# PROXY_HYBRID=0
# PROXY_HTTP_URL=http://host:16857:user:pass
# PROXY_PREFER=socks
PROXY_ROTATE_URL=https://your-provider/changeip/token
# PROXY_ROTATE_WAIT_MS=10000
# iProxy changeip is usually ready in <10s. Code default is 10s (was wrongly forced to 30s).
# PROXY_ROTATE_WAIT_MIN_MS=8000
# Min seconds between IP rotations (stops email-retry thrash killing smart-refresh)
# PROXY_ROTATE_COOLDOWN_MS=120000
# Wait for Camoufox pool to drain before rotating (ms)
# PROXY_ROTATE_DRAIN_MS=15000
# Max wait for live Camoufox relay pins before IP rotate (LOGIN_PARALLEL=2 needs this >> 15s)
# PROXY_ROTATE_PIN_WAIT_MS=200000
# How long to block starting a new login while waiting for a successful rotate
# PROXY_ROTATE_BLOCK_WAIT_MS=240000
# Non-hybrid only: after this many mobile browserless successes, idle-rotate the phone IP.
# Hybrid/residential: ignored — Loki uses residential (new exit per request); mobile rotates after logins.
# PROXY_HTTP_ROTATE_EVERY=100
# Optional clean IP before login after N HTTP ops (0 = off — keep same IP for PROXY_ROTATE_EVERY logins)
# PROXY_LOGIN_CLEAN_IP_AFTER_HTTP=0
# Gap between batch logins (ms base) — GetCredentialType rate-limits rapid lookups
# LOGIN_BATCH_DELAY_MS=12000
# Parallel Camoufox logins — default 1. Prefer the dashboard "Parallel" dropdown (saved in DB).
# Env only seeds the DB on first boot. Optional lock: LOGIN_PARALLEL_LOCK=1 ignores the dashboard.
# LOGIN_PARALLEL=5
# LOGIN_PARALLEL_FORCE=1
# LOGIN_PARALLEL_LOCK=0
# Gap between starting each parallel browser (ms). Default 8000.
# LOGIN_PARALLEL_STAGGER_MS=8000
# Max forced IP rotates per login job when Microsoft returns 429
# LOGIN_MAX_THROTTLE_ROTATES=2
# Don't dedupe non-force rotates if another job rotated within this window (ms)
# PROXY_SHARED_ROTATE_MIN_GAP_MS=25000
# Rotate mobile IP only AFTER this many successful Camoufox logins (never mid-login / email retry)
# PROXY_ROTATE_EVERY=6
# Settle after a batch rotate (ms) — only when rotating between login batches
# PROXY_POST_ROTATE_SETTLE_MS=8000
# Camoufox geoip (PRO): spoof timezone/locale/WebRTC to proxy exit IP. Keep ON.
# If geoip fails, WebRTC is blocked so Coolify host IP cannot leak.
# CAMOUFOX_GEOIP=1
# Re-download Camoufox binary after package bumps (set once, then remove):
# CAMOUFOX_FORCE_FETCH=1

# Smart refresh — HTTP/Loki fast lane + Camoufox slow lane (refills immediately)
# SMART_REFRESH_INTERVAL_MS=60000
# SMART_REFRESH_BROWSERLESS_PARALLEL=4
# Hybrid login: Loki on residential + cookie SSO on mobile (both keep running).
# SMART_REFRESH_BROWSERLESS_PARALLEL_BUSY=1
# SMART_REFRESH_TICK_BATCH_SIZE_BUSY=2
# SMART_REFRESH_LOGIN_LOKI_GAP_MS=2500
# Fail-fast Loki/MSAL token POST (ms). Cookie SSO uses its own longer timeout.
# BROWSERLESS_HTTP_TIMEOUT_MS=8000
# Cookie SSO parallel on mobile (idle / during Camoufox login).
# COOKIE_SSO_PARALLEL=4
# COOKIE_SSO_PARALLEL_LOGIN=1
# Manual Refresh button concurrency.
# REFRESH_JOB_PARALLEL=6
# LOGIN_HTTP_COOLDOWN_MS=90000
# Brief full HTTP quiet only around GetCredentialType when hybrid is OFF.
# LOGIN_LIVE_SHIELD_MS=45000
# After gct=429: only retry if changeip verified a new exit IP; settle this long first.
# GCT_429_SETTLE_MS=60000
# After a failed GCT recovery: pause next logins / rotate so we don't burn the queue.
# GCT_HOT_COOLDOWN_MS=120000
# Settle after a successful login-batch rotate (default 45s — 8s was too short).
# PROXY_POST_ROTATE_SETTLE_MS=45000
# SMART_REFRESH_CAMOUFOX_PARALLEL=3
# (↑ only smart-refresh Camoufox — login parallelism is LOGIN_PARALLEL above)
# ACCOUNTS_CACHE_TTL_MS=8000
# SMART_REFRESH_AUTO_PAUSE_QUEUE_AT=50
# SMART_REFRESH_FAIL_BACKOFF_MS=900000
# SMART_REFRESH_BUFFER_MS=1200000
# SMART_REFRESH_PRIORITY_WINDOW_MS=1800000
# Optional explicit iProxy HTTP (else derived as SOCKS port-682):
# PROXY_HTTP_URL=http://host:16857:user:pass

# Optional — push account.token_updated to your app (see SYNC-API.md)
# SYNC_WEBHOOK_URL=https://your-app.com/hooks/headless-login
# SYNC_WEBHOOK_SECRET=optional-hmac-secret
