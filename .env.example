PORT=3847
DATA_DIR=/app/data
CREDENTIALS_KEY=change-me-to-a-long-random-secret
API_KEY=change-me-to-a-long-random-api-key-min-16-chars
CAMOUFOX_INSTALL_DIR=/app/data/camoufox
MOZ_DISABLE_CONTENT_SANDBOX=1
MOZ_DISABLE_GMP_SANDBOX=1
PROXY_URL=socks5://host:port:user:pass
PROXY_ROTATE_URL=https://your-provider/changeip/token
PROXY_ROTATE_WAIT_MS=30000

# Smart refresh — fast lane (parallel HTTP) + slow lane (parallel Camoufox, separate from login queue)
# SMART_REFRESH_INTERVAL_MS=60000
# SMART_REFRESH_BROWSERLESS_PARALLEL=4
# SMART_REFRESH_CAMOUFOX_PARALLEL=2
# SMART_REFRESH_MAX_CAMOUFOX_PER_TICK=2
# SMART_REFRESH_FAIL_BACKOFF_MS=900000
# SMART_REFRESH_BUFFER_MS=5400000

# Optional — push account.token_updated to your app (see SYNC-API.md)
# SYNC_WEBHOOK_URL=https://your-app.com/hooks/headless-login
# SYNC_WEBHOOK_SECRET=optional-hmac-secret
